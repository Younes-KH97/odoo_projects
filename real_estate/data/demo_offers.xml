<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!--
      Create offers using partners already defined in the database.
      The XML uses an eval search to find the partner by name.
      Adjust the property reference (real_estate.property_1) if your property record id differs.
    -->

    <record id="offer_azure_10000" model="property.offer">
      <field name="partner_id" eval="env['res.partner'].search([('name', '=', 'Azure Interior')], limit=1).id"/>
      <field name="estate_property_id" eval="env['estate_property'].search([('name', '=', 'Big Villa')], limit=1).id"/>
      <field name="price">10000.0</field>
      <field name="validity">14</field>
      <field name="date_deadline" eval="(context_today() + relativedelta(days=14)).strftime('%Y-%m-%d')"/>
    </record>

    <record id="offer_azure_1500000" model="property.offer">
      <field name="partner_id" eval="env['res.partner'].search([('name', '=', 'Azure Interior')], limit=1).id"/>
      <field name="estate_property_id" eval="env['estate_property'].search([('name', '=', 'Big Villa')], limit=1).id"/>
      <field name="price">1500000.0</field>
      <field name="validity">14</field>
      <field name="date_deadline" eval="(context_today() + relativedelta(days=14)).strftime('%Y-%m-%d')"/>
    </record>

    <record id="offer_deco_1500001" model="property.offer">
      <field name="partner_id" eval="env['res.partner'].search([('name', '=', 'Deco Addict')], limit=1).id"/>
      <field name="estate_property_id" eval="env['estate_property'].search([('name', '=', 'Big Villa')], limit=1).id"/>
      <field name="price">1500001.0</field>
      <field name="validity">14</field>
      <field name="date_deadline" eval="(context_today() + relativedelta(days=14)).strftime('%Y-%m-%d')"/>
    </record>

  </data>
</odoo>
